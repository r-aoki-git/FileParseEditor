<Window x:Class="FileParseEditor.Views.AddKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="キーの追加"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=KeyBox}">
    <!-- 基本設計書 3-5-2 -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="セクション" Margin="0,0,8,6" />
        <TextBlock x:Name="SectionText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="キー名" VerticalAlignment="Center" Margin="0,0,8,6" />
        <TextBox x:Name="KeyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="値" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="ValueBox" Grid.Row="2" Grid.Column="1" FontFamily="Consolas, MS Gothic" />

        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="LFC の表記で入力します（例：1,&quot;tasiro&quot;,2）。空欄は値なしになります。" />

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="OnOkClick" />
            <Button Content="キャンセル" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
